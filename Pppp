    chattr -i /etc/resolv.conf >/dev/null 2>&1
    systemctl disable systemd-resolved > /dev/null 2>&1 || true
    systemctl stop systemd-resolved > /dev/null 2>&1 || true
    rm -f /etc/resolv.conf > /dev/null 2>&1
